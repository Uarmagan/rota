# OpenAI API key, required for the parser and prose LLM boundaries
OPENAI_API_KEY=

# Model for both LLM call sites, an OpenAI model id
ROTA_MODEL=gpt-5.6-luna

# Set to true only after the exact rota-paid-api-visitor WAF rule is live for this environment.
# Vercel deployments fail closed unless this exact non-secret attestation is true.
ROTA_PAID_RATE_LIMIT_CONFIGURED=false

# Per-process model-call defense-in-depth controls. These are not the shared allowance.
ROTA_MODEL_MAX_CONCURRENCY=4
ROTA_MODEL_GLOBAL_CALLS_PER_MINUTE=60
ROTA_MODEL_CLIENT_CALLS_PER_MINUTE=10
ROTA_MODEL_MAX_CLIENT_KEYS=1000

# Per-process search-stream controls. These counters are separate from paid requests.
ROTA_SEARCH_MAX_CONCURRENCY=8
ROTA_SEARCH_GLOBAL_REQUESTS_PER_10_MINUTES=600
ROTA_SEARCH_CLIENT_REQUESTS_PER_10_MINUTES=60
ROTA_SEARCH_MAX_CLIENT_KEYS=1000

# Enable only after verifying direct authoritative Vercel ingress.
ROTA_TRUST_FORWARDED_ADDRESS=false
